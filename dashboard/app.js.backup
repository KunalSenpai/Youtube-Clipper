let state={videos:[],accounts:[],jobs:[]};
let selected=new Set();

async function loadState(){
  const r=await fetch('/api/state'); state=await r.json();
  render();
}
function render(){
  document.getElementById('statVideos').textContent=state.stats.videos;
  document.getElementById('statPending').textContent=state.stats.pending;
  document.getElementById('statUploaded').textContent=state.stats.uploaded;
  document.getElementById('statRunning').textContent=state.stats.running;
  renderAccounts(); renderVideos(); renderTable(); renderJobs(); updateCount();
}
function renderAccounts(){
  const platform=document.getElementById('platform').value;
  const sel=document.getElementById('account');
  const accounts=state.accounts.filter(a=>a.platform===platform);
  sel.innerHTML=accounts.length ? accounts.map(a=>`<option value="${esc(a.id)}">${esc(a.name)}</option>`).join('') : '<option value="">No account configured</option>';
  selected.clear(); renderVideos(); renderTable(); updateCount();
  document.getElementById('uploadHint').textContent =
    platform==='youtube'
    ? 'YouTube uses the existing OAuth uploader, per-account token and scheduling.'
    : 'Instagram is shown here as a destination, but requires Meta/Instagram publishing configuration.';
}
function renderVideos(){
  const account=document.getElementById('account').value;
  const grid=document.getElementById('videoGrid');
  grid.innerHTML=state.videos.map(v=>{
    const uploaded=(v.uploaded_accounts||[]).includes(account);
    return `
    <div class="video-card ${selected.has(v.path)?'selected':''}" onclick="toggle('${jsq(v.path)}')">
      <div class="thumb"><video muted preload="metadata" src="/media?path=${encodeURIComponent(v.path)}"></video></div>
      <div class="video-meta">
        <b>${esc(v.name)}</b>
        <small>${esc(v.folder)} · ${v.size_mb} MB</small>
        <span class="badge ${uploaded?'done':''}">${uploaded?'Uploaded':'Pending'}</span>
      </div>
    </div>`;
  }).join('') || '<p>No rendered Shorts found. Run main.py first.</p>';
}
function renderTable(){
  const el=document.getElementById('videoTable');
  const account=document.getElementById('account').value;
  el.innerHTML=state.videos.map(v=>{
    const uploaded=(v.uploaded_accounts||[]).includes(account);
    return `<div class="row">
    <div><b>${esc(v.name)}</b><span>${esc(v.folder)}</span></div>
    <div>${v.size_mb} MB</div><div>${esc(v.modified)}</div>
    <div class="status ${uploaded?'success':''}">${uploaded?'Uploaded':'Pending'}</div>
  </div>`;
  }).join('');
}
function renderJobs(){
  const el=document.getElementById('jobs');
  el.innerHTML=state.jobs.map(j=>`<div class="row">
    <div><b>${esc(j.id)}</b><span>${esc(j.account_id)} · ${esc(j.platform)}</span></div>
    <div class="status ${j.status}">${esc(j.status)}</div>
    <div>${esc(j.created_at||'')}</div>
    <div>${j.error?esc(j.error):j.exit_code===0?'OK':'—'}</div>
  </div>`).join('') || '<p>No dashboard jobs yet.</p>';
}
function toggle(path){selected.has(path)?selected.delete(path):selected.add(path);renderVideos();updateCount()}
function selectPending(){
  const account=document.getElementById('account').value;
  state.videos.filter(v=>!(v.uploaded_accounts||[]).includes(account)).forEach(v=>selected.add(v.path));
  renderVideos();renderTable();updateCount()
}
function clearSelection(){selected.clear();renderVideos();updateCount()}
function updateCount(){document.getElementById('selectionCount').textContent=`${selected.size} selected`}
async function startUpload(){
  const platform=document.getElementById('platform').value;
  const account=document.getElementById('account').value;
  if(!selected.size){toast('Select at least one Short.');return}
  if(!account){toast('Configure an account first.');return}
  const r=await fetch('/api/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({platform,account_id:account,files:[...selected]})});
  const data=await r.json();
  if(!data.ok){toast(data.error||'Could not start upload.');return}
  toast(`Upload job ${data.job_id} started.`);
  selected.clear(); loadState();
}
function nav(section){
 document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));
 document.getElementById(section).classList.add('active');
 document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.section===section));
 document.getElementById('pageTitle').textContent=section==='settings'?'Accounts & Settings':section[0].toUpperCase()+section.slice(1);
}
document.querySelectorAll('.nav').forEach(x=>x.onclick=()=>nav(x.dataset.section));
function toast(s){const t=document.getElementById('toast');t.textContent=s;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2800)}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function jsq(s){return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'")}
loadState(); setInterval(loadState,5000);
